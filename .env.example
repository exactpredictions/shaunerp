# Copy to .env and adjust. Used by docker-compose.

POSTGRES_USER=shaunerp
POSTGRES_PASSWORD=shaunerp_dev_change_me
POSTGRES_DB=shaunerp
POSTGRES_PORT=5432

# API
ASPNETCORE_ENVIRONMENT=Development
JWT_ISSUER=shaunerp
JWT_AUDIENCE=shaunerp
# Use a long random string in production (32+ chars)
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32CHARS
API_PORT=8080

# Connection string for local (non-Docker) runs
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=shaunerp;Username=shaunerp;Password=shaunerp_dev_change_me
