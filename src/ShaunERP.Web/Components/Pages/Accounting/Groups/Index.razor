@page "/accounting/groups"
@attribute [Authorize]
@inject IAccountingService Accounting
@inject ShellStateService Shell
@inject ITenantContext Tenant
@inject IModuleRegistry Modules

<PageTitle>Account groups — ShaunERP</PageTitle>
<section class="page">
    <header class="page-head"><div><p class="eyebrow">Masters</p><h1>Account groups</h1></div></header>
    @if (_error is not null) { <div class="error-state">@_error</div> }
    else if (_loading) { <div class="loading-state">Loading…</div> }
    else
    {
        <table class="data-table">
            <thead><tr><th>Code</th><th>Name</th><th>Nature</th><th>System</th></tr></thead>
            <tbody>
            @foreach (var g in _groups)
            {
                <tr><td>@g.GroupCode</td><td>@g.GroupName</td><td>@g.Nature</td><td>@(g.IsSystemGroup ? "Yes" : "")</td></tr>
            }
            </tbody>
        </table>
    }
</section>
@code {
    private bool _loading = true;
    private string? _error;
    private List<AccountGroup> _groups = new();
    protected override async Task OnInitializedAsync()
    {
        await Shell.InitializeAsync();
        var mod = Modules.GetByKey(ModuleKeys.Accounting);
        if (mod is null || !Modules.CanAccessModule(mod, Tenant)) { _error = "Access denied."; _loading = false; return; }
        try { await Accounting.EnsureBootstrapAsync(); _groups = (await Accounting.ListGroupsAsync()).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
