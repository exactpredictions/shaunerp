@page "/accounting/vouchers"
@attribute [Authorize]
@inject IAccountingService Accounting
@inject ITenantContext Tenant
@inject IModuleRegistry Modules
@inject ShellStateService Shell

<PageTitle>Vouchers — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">Accounting</p>
            <h1>All vouchers</h1>
        </div>
        <div class="form-actions">
            <a class="btn" href="/accounting/vouchers/journal">Journal</a>
            <a class="btn ghost" href="/accounting/vouchers/receipt">Receipt</a>
            <a class="btn ghost" href="/accounting/vouchers/payment">Payment</a>
            <a class="btn ghost" href="/accounting/vouchers/contra">Contra</a>
        </div>
    </header>

    @if (_error is not null) { <div class="error-state">@_error</div> }
    else if (_loading) { <div class="loading-state">Loading…</div> }
    else
    {
        <table class="data-table">
            <thead><tr><th>Date</th><th>Number</th><th>Type</th><th>Narration</th><th>Status</th><th class="num">Amount</th></tr></thead>
            <tbody>
            @foreach (var v in _rows)
            {
                <tr>
                    <td>@v.VoucherDate.ToString("dd-MMM-yyyy")</td>
                    <td><a href="/accounting/vouchers/@v.Id">@v.VoucherNumber</a></td>
                    <td>@(v.VoucherType?.Name ?? "—")</td>
                    <td>@(v.Narration ?? "—")</td>
                    <td>@v.VoucherStatus</td>
                    <td class="num">@v.TotalDebit.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@code {
    private bool _loading = true;
    private string? _error;
    private List<AccountingVoucher> _rows = new();

    protected override async Task OnInitializedAsync()
    {
        await Shell.InitializeAsync();
        var mod = Modules.GetByKey(ModuleKeys.Accounting);
        if (mod is null || !Modules.CanAccessModule(mod, Tenant)) { _error = "Access denied."; _loading = false; return; }
        try { _rows = (await Accounting.ListVouchersAsync()).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
