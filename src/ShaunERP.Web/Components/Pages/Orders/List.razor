@page "/orders/list"
@attribute [Authorize]
@using ShaunERP.Core.Sales
@inject ISalesOrderService Orders

<PageTitle>Sales orders — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div><p class="eyebrow">Sales Orders</p><h1>Sales orders</h1></div>
        <a class="btn" href="/orders/new">New order</a>
    </header>
    @if (_loading) { <p class="muted">Loading…</p> }
    else if (_error is not null) { <div class="error-state">@_error</div> }
    else if (_items.Count == 0) { <p class="muted">No sales orders yet. <a href="/orders/new">Create the first order</a>.</p> }
    else
    {
        <div class="table-wrap"><table>
            <thead>
                <tr>
                    <th>Number</th>
                    <th>Customer</th>
                    <th>Order date</th>
                    <th>Delivery</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>To invoice</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var x in _items)
            {
                <tr>
                    <td>@x.OrderNumber</td>
                    <td>@(x.CustomerName ?? x.Customer?.CompanyName ?? "—")</td>
                    <td>@x.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@(x.RequestedDeliveryDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td><span class="pill @StatusClass(x)">@x.DisplayStatus</span></td>
                    <td>@x.GrandTotal.ToString("N2") @x.CurrencyCode</td>
                    <td>@x.BalanceToInvoice.ToString("N2")</td>
                    <td><a href="@($"/orders/{x.Id}")">Open</a></td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>

@code {
    private bool _loading = true;
    private string? _error;
    private List<SalesOrder> _items = new();

    protected override async Task OnInitializedAsync()
    {
        try { _items = (await Orders.ListOrdersAsync()).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private static string StatusClass(SalesOrder x) => x.OrderStatus switch
    {
        SalesOrderStatus.Invoiced => "ok",
        SalesOrderStatus.Confirmed or SalesOrderStatus.Fulfilled => "ok",
        SalesOrderStatus.Cancelled => "off",
        SalesOrderStatus.PartiallyInvoiced => "ok",
        _ => ""
    };
}
