@page "/orders/list"
@attribute [Authorize]
@inject ISalesOrderService Orders

<PageTitle>Sales orders — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">Orders</p>
            <h1>Sales orders</h1>
        </div>
        <a class="btn" href="/orders/new">New order</a>
    </header>

    <ImportExportPanel EntityKey="sales-orders" />

    <PagedListToolbar Query="_query" TotalCount="_total" Disabled="_loading"
                      SearchPlaceholder="Search order #, customer, PO…"
                      QueryChanged="OnQueryChangedAsync" />

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">No matching rows.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in _items)
                    {
                        <tr>
                            <td>@x.OrderNumber</td>
                            <td>@(x.CustomerName ?? "—")</td>
                            <td>@x.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>@x.DisplayStatus</td>
                            <td>@x.GrandTotal.ToString("N2")</td>
                            <td><a href="@($"/orders/{x.Id}")">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private ListQuery _query = new();
    private int _total;
    private List<SalesOrder> _items = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnQueryChangedAsync(ListQuery query)
    {
        _query = query;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var page = await Orders.QueryOrdersAsync(_query);
            _items = page.Items.ToList();
            _total = page.TotalCount;
            _query = new ListQuery { Search = _query.Search, Page = page.Page, PageSize = page.PageSize };
        }
        finally
        {
            _loading = false;
        }
    }
}
