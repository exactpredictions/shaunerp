@page "/orders/new"
@page "/orders/{Id:int}"
@attribute [Authorize]
@using System.Globalization
@using ShaunERP.Core.Sales
@inject ISalesOrderService Orders
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "New sales order" : "Edit sales order") — ShaunERP</PageTitle>

<section class="page invoice-edit">
    <header class="page-head">
        <div>
            <p class="eyebrow">Sales Orders</p>
            <h1>@(_isNew ? "New sales order" : (_model.OrderNumber is { Length: > 0 } ? _model.OrderNumber : $"Order #{Id}"))</h1>
            @if (!_isNew)
            {
                <p class="muted">
                    Status: <span class="pill @StatusPillClass(_model)">@_model.DisplayStatus</span>
                    · @(_model.CurrencyCode ?? "USD") @_model.GrandTotal.ToString("N2")
                    · To invoice @_model.BalanceToInvoice.ToString("N2")
                    @if (_dirty) { <span class="invoice-dirty"> · Unsaved changes</span> }
                </p>
            }
            else if (_dirty)
            {
                <p class="muted"><span class="invoice-dirty">Unsaved changes</span></p>
            }
        </div>
        <div class="page-head-actions">
            <a class="btn ghost" href="/orders/list">Back</a>
        </div>
    </header>

    @if (_loading) { <p class="muted">Loading…</p> }
    else if (!_isNew && _missing) { <p class="alert">Not found.</p> }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveDraftAsync" class="invoice-form">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert">@_error</div> }
            @if (!string.IsNullOrEmpty(_ok)) { <div class="ok-msg">@_ok</div> }

            <section class="invoice-panel">
                <header class="invoice-panel-head">
                    <h2>Header</h2>
                    <p class="muted">General order details</p>
                </header>
                <div class="invoice-header-grid">
                    <label>Order number
                        <InputText @bind-Value="_model.OrderNumber" @bind-Value:after="MarkDirty"
                                   placeholder="Auto on save" disabled="@(_isLocked || !_isDraft)" />
                    </label>
                    <label>Status
                        <input class="readonly-field" value="@_model.DisplayStatus" readonly tabindex="-1" />
                    </label>
                    <label>Customer
                        <InputSelect @bind-Value="_customerIdStr" @bind-Value:after="OnCustomerChangedAsync" disabled="@_isLocked">
                            <option value="">— Select CRM customer —</option>
                            @foreach (var c in _customers)
                            {
                                <option value="@c.Id">@(c.CompanyName ?? $"Customer #{c.Id}")</option>
                            }
                        </InputSelect>
                    </label>
                    <label>Salesperson
                        <InputText @bind-Value="_model.Salesperson" @bind-Value:after="MarkDirty" disabled="@_isLocked" />
                    </label>
                    <label>Order date
                        <InputDate @bind-Value="_orderDate" @bind-Value:after="MarkDirty" disabled="@_isLocked" />
                    </label>
                    <label>Requested delivery
                        <InputDate @bind-Value="_deliveryDate" @bind-Value:after="MarkDirty" disabled="@_isLocked" />
                    </label>
                    <label>Payment terms
                        <InputText @bind-Value="_model.PaymentTerms" @bind-Value:after="MarkDirty" disabled="@_isLocked" />
                    </label>
                    <label>Currency
                        <InputText @bind-Value="_model.CurrencyCode" @bind-Value:after="MarkDirty" disabled="@_isLocked" />
                    </label>
                    <label>Customer PO
                        <InputText @bind-Value="_model.PurchaseOrderNumber" @bind-Value:after="MarkDirty" disabled="@_isLocked" />
                    </label>
                </div>
                <label class="invoice-span">Bill-to address
                    <InputTextArea @bind-Value="_model.BillToAddress" @bind-Value:after="MarkDirty" rows="2" disabled="@_isLocked" />
                </label>
                <label class="invoice-span">Ship-to address
                    <InputTextArea @bind-Value="_model.ShipToAddress" @bind-Value:after="MarkDirty" rows="2" disabled="@_isLocked" />
                </label>
            </section>

            <section class="invoice-panel">
                <header class="invoice-panel-head">
                    <h2>Line items</h2>
                    <p class="muted">Add products or custom lines · totals recalculate as you type</p>
                </header>
                <div class="invoice-lines-wrap">
                    <table class="invoice-lines">
                        <thead>
                            <tr>
                                <th class="col-num">#</th>
                                <th class="col-product">Product</th>
                                <th class="col-desc">Description</th>
                                <th class="col-qty">Qty</th>
                                <th class="col-price">Unit price</th>
                                <th class="col-disc">Disc %</th>
                                <th class="col-tax">Tax %</th>
                                <th class="col-amt">Amount</th>
                                <th class="col-actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_lines.Count == 0)
                        {
                            <tr class="invoice-empty-row">
                                <td colspan="9">
                                    <span class="muted">No lines yet.</span>
                                    @if (!_isLocked)
                                    {
                                        <button class="btn ghost" type="button" @onclick="AddLine">Add line</button>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (var i = 0; i < _lines.Count; i++)
                            {
                                var idx = i;
                                <tr>
                                    <td class="col-num">@(idx + 1)</td>
                                    <td class="col-product">
                                        <select value="@(_lines[idx].ProductId?.ToString() ?? "")" disabled="@_isLocked"
                                                @onchange="e => OnProductChanged(idx, e.Value?.ToString())">
                                            <option value="">Custom</option>
                                            @foreach (var p in _products)
                                            {
                                                <option value="@p.Id">@p.Name</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="col-desc">
                                        <input value="@LineDescription(_lines[idx])" disabled="@_isLocked"
                                               @onchange="e => OnDescriptionChanged(idx, e.Value?.ToString())" placeholder="Description" />
                                    </td>
                                    <td class="col-qty">
                                        <input type="number" step="any" min="0" value="@Fmt(_lines[idx].Quantity)" disabled="@_isLocked"
                                               @onchange="e => OnLineDecimal(idx, nameof(SalesOrderLine.Quantity), e.Value?.ToString())" />
                                    </td>
                                    <td class="col-price">
                                        <input type="number" step="any" min="0" value="@Fmt(_lines[idx].UnitPrice)" disabled="@_isLocked"
                                               @onchange="e => OnLineDecimal(idx, nameof(SalesOrderLine.UnitPrice), e.Value?.ToString())" />
                                    </td>
                                    <td class="col-disc">
                                        <input type="number" step="any" min="0" max="100" value="@Fmt(_lines[idx].Discount)" disabled="@_isLocked"
                                               @onchange="e => OnLineDecimal(idx, nameof(SalesOrderLine.Discount), e.Value?.ToString())" />
                                    </td>
                                    <td class="col-tax">
                                        <input type="number" step="any" min="0" max="100" value="@Fmt(_lines[idx].TaxRate)" disabled="@_isLocked"
                                               @onchange="e => OnLineDecimal(idx, nameof(SalesOrderLine.TaxRate), e.Value?.ToString())" />
                                    </td>
                                    <td class="col-amt mono">@ComputeLineTotal(_lines[idx]).ToString("N2")</td>
                                    <td class="col-actions">
                                        @if (!_isLocked)
                                        {
                                            <button class="btn-icon danger" type="button" title="Remove line"
                                                    @onclick="() => RemoveLine(idx)" disabled="@(_lines.Count <= 1)">×</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
                @if (!_isLocked)
                {
                    <div class="invoice-lines-footer">
                        <button class="btn ghost" type="button" @onclick="AddLine">+ Add line</button>
                    </div>
                }
            </section>

            <section class="invoice-panel invoice-footer-panel">
                <header class="invoice-panel-head">
                    <h2>Totals &amp; notes</h2>
                    <p class="muted">Document summary and actions</p>
                </header>
                <div class="invoice-footer-grid">
                    <div class="invoice-notes">
                        <label>Notes
                            <InputTextArea @bind-Value="_model.Notes" @bind-Value:after="MarkDirty" rows="3" disabled="@_isLocked" />
                        </label>
                        <label>Terms
                            <InputTextArea @bind-Value="_model.Terms" @bind-Value:after="MarkDirty" rows="3" disabled="@_isLocked" />
                        </label>
                    </div>
                    <div class="invoice-totals" @key="_totalsVersion">
                        <div class="tot-row"><span>Subtotal</span><strong class="mono">@_liveSubtotal.ToString("N2")</strong></div>
                        <div class="tot-row tot-edit">
                            <label>Document discount
                                <InputNumber @bind-Value="_model.Discount" @bind-Value:after="OnDocumentDiscountChanged" disabled="@_isLocked" />
                            </label>
                        </div>
                        <div class="tot-row"><span>Tax</span><strong class="mono">@_liveTax.ToString("N2")</strong></div>
                        <div class="tot-row tot-grand">
                            <span>Grand total</span>
                            <strong class="mono">@_liveGrand.ToString("N2") @_model.CurrencyCode</strong>
                        </div>
                        @if (!_isNew)
                        {
                            <div class="tot-row"><span>Amount invoiced</span><strong class="mono">@_model.AmountInvoiced.ToString("N2")</strong></div>
                            <div class="tot-row tot-balance"><span>Balance to invoice</span><strong class="mono">@Math.Max(0, _liveGrand - _model.AmountInvoiced).ToString("N2")</strong></div>
                        }
                    </div>
                </div>

                <div class="form-actions invoice-actions">
                    @if (!_isLocked)
                    {
                        <button class="btn" type="submit" disabled="@_saving">@(_saving ? "Saving…" : (_isNew || _isDraft ? "Save draft" : "Save"))</button>
                    }
                    @if (!_isNew && _isDraft && !_isLocked)
                    {
                        <button class="btn ghost" type="button" disabled="@_saving" @onclick="ConfirmAsync">Confirm</button>
                    }
                    @if (!_isNew && _model.OrderStatus == SalesOrderStatus.Confirmed && !_isLocked)
                    {
                        <button class="btn ghost" type="button" disabled="@_saving" @onclick="FulfillAsync">Mark fulfilled</button>
                    }
                    @if (!_isNew && _model.OrderStatus is SalesOrderStatus.Confirmed or SalesOrderStatus.Fulfilled or SalesOrderStatus.PartiallyInvoiced)
                    {
                        <button class="btn ghost" type="button" disabled="@_saving" @onclick="CreateInvoiceAsync">Create invoice</button>
                    }
                    @if (!_isNew && _model.OrderStatus is not SalesOrderStatus.Cancelled and not SalesOrderStatus.Invoiced)
                    {
                        <button class="btn ghost danger" type="button" disabled="@_saving" @onclick="CancelAsync">Cancel order</button>
                    }
                    @if (!_isNew && _isDraft)
                    {
                        <button class="btn ghost danger" type="button" disabled="@_saving" @onclick="DeleteAsync">Delete</button>
                    }
                </div>
            </section>
        </EditForm>

        @if (!_isNew && _model.Invoices?.Count > 0)
        {
            <section class="invoice-panel">
                <header class="invoice-panel-head">
                    <h2>Linked invoices</h2>
                    <p class="muted">Invoices created from this order</p>
                </header>
                <div class="table-wrap"><table>
                    <thead><tr><th>Number</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var inv in _model.Invoices.OrderByDescending(i => i.Id))
                    {
                        <tr>
                            <td>@inv.InvoiceNumber</td>
                            <td>@inv.InvoiceDate.ToString("yyyy-MM-dd")</td>
                            <td>@inv.DisplayStatus</td>
                            <td class="mono">@((inv.GrandTotal > 0 ? inv.GrandTotal : inv.Amount).ToString("N2"))</td>
                            <td><a href="@($"/finance/invoices/{inv.Id}")">Open</a></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </section>
        }
    }
</section>

@code {
    [Parameter] public int Id { get; set; }

    private bool _isNew, _loading = true, _missing, _dirty, _saving;
    private SalesOrder _model = new() { OrderStatus = SalesOrderStatus.Draft, CurrencyCode = "USD" };
    private List<SalesOrderLine> _lines = [new() { Quantity = 1 }];
    private List<Customer> _customers = new();
    private List<CrmProduct> _products = new();
    private string _customerIdStr = "";
    private DateTime? _orderDate = DateTime.UtcNow.Date;
    private DateTime? _deliveryDate;
    private string? _error, _ok, _cleanFingerprint;
    private decimal _liveSubtotal, _liveTax, _liveGrand;
    private int _totalsVersion;

    private bool _isDraft => _model.OrderStatus == SalesOrderStatus.Draft;
    private bool _isLocked => _model.OrderStatus is SalesOrderStatus.Cancelled or SalesOrderStatus.Invoiced;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; _ok = null; _missing = false; _dirty = false;
        _isNew = Nav.ToBaseRelativePath(Nav.Uri).Contains("orders/new", StringComparison.OrdinalIgnoreCase);
        try
        {
            _customers = (await Orders.ListCrmCustomersAsync()).ToList();
            _products = (await Orders.ListProductsAsync()).ToList();
            if (_isNew)
            {
                _model = new SalesOrder
                {
                    OrderStatus = SalesOrderStatus.Draft,
                    CurrencyCode = "USD",
                    OrderDate = DateTime.UtcNow.Date,
                    RequestedDeliveryDate = DateTime.UtcNow.Date.AddDays(7)
                };
                _lines = [new SalesOrderLine { Quantity = 1 }];
                _customerIdStr = "";
                _orderDate = _model.OrderDate.Date;
                _deliveryDate = _model.RequestedDeliveryDate?.Date;
                RecalcLiveTotals();
                CaptureClean();
                return;
            }

            var row = await Orders.GetOrderAsync(Id);
            if (row is null) { _missing = true; return; }
            ApplyLoaded(row);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void ApplyLoaded(SalesOrder row)
    {
        _model = row;
        _lines = row.Lines?.OrderBy(l => l.SortOrder).Select(CloneLine).ToList() ?? [new SalesOrderLine { Quantity = 1 }];
        if (_lines.Count == 0) _lines.Add(new SalesOrderLine { Quantity = 1 });
        _customerIdStr = row.CustomerId?.ToString() ?? "";
        _orderDate = row.OrderDate.Date;
        _deliveryDate = row.RequestedDeliveryDate?.Date;
        RecalcLiveTotals();
        CaptureClean();
        _dirty = false;
    }

    private static SalesOrderLine CloneLine(SalesOrderLine l) => new()
    {
        Id = l.Id, ProductId = l.ProductId, ProductName = l.ProductName, Description = l.Description,
        Quantity = l.Quantity, UnitPrice = l.UnitPrice, Discount = l.Discount, TaxRate = l.TaxRate,
        TaxAmount = l.TaxAmount, LineTotal = l.LineTotal, SortOrder = l.SortOrder
    };

    private void MarkDirty() { _dirty = Fingerprint() != _cleanFingerprint; _ok = null; }
    private void CaptureClean() { RecalcLiveTotals(); _cleanFingerprint = Fingerprint(); _dirty = false; }

    private string Fingerprint()
    {
        var lines = string.Join("|", _lines.Select(l =>
            $"{l.ProductId}:{l.ProductName}:{l.Description}:{l.Quantity}:{l.UnitPrice}:{l.Discount}:{l.TaxRate}"));
        return string.Join("·", _customerIdStr, _model.OrderNumber, _orderDate?.ToString("O"), _deliveryDate?.ToString("O"),
            _model.CurrencyCode, _model.PaymentTerms, _model.PurchaseOrderNumber, _model.BillToAddress, _model.ShipToAddress,
            _model.Salesperson, _model.Notes, _model.Terms, _model.Discount.ToString(CultureInfo.InvariantCulture), lines);
    }

    private void AddLine()
    {
        if (_isLocked) return;
        _lines.Add(new SalesOrderLine { Quantity = 1, SortOrder = _lines.Count });
        RecalcLiveTotals(); MarkDirty();
    }

    private void RemoveLine(int idx)
    {
        if (_isLocked || _lines.Count <= 1) return;
        _lines.RemoveAt(idx); RecalcLiveTotals(); MarkDirty();
    }

    private async Task OnCustomerChangedAsync()
    {
        MarkDirty();
        if (!int.TryParse(_customerIdStr, out var cid) || cid <= 0) { _model.CustomerId = null; return; }
        var customer = _customers.FirstOrDefault(c => c.Id == cid);
        if (customer is null) return;
        _model.CustomerId = customer.Id;
        _model.CustomerName = customer.CompanyName;
        if (!string.IsNullOrWhiteSpace(customer.BillingAddress)) _model.BillToAddress = customer.BillingAddress;
        if (!string.IsNullOrWhiteSpace(customer.ShippingAddress)) _model.ShipToAddress = customer.ShippingAddress;
        else if (!string.IsNullOrWhiteSpace(customer.BillingAddress)) _model.ShipToAddress = customer.BillingAddress;
        if (!string.IsNullOrWhiteSpace(customer.PaymentTerms)) _model.PaymentTerms = customer.PaymentTerms;
        if (!string.IsNullOrWhiteSpace(customer.CustomerOwner)) _model.Salesperson = customer.CustomerOwner;
        await Task.CompletedTask;
    }

    private void OnProductChanged(int idx, string? value)
    {
        if (_isLocked) return;
        if (!int.TryParse(value, out var productId) || productId <= 0) { _lines[idx].ProductId = null; MarkDirty(); return; }
        var product = _products.FirstOrDefault(p => p.Id == productId);
        if (product is null) return;
        _lines[idx].ProductId = product.Id;
        _lines[idx].ProductName = product.Name;
        _lines[idx].UnitPrice = product.UnitPrice;
        _lines[idx].TaxRate = product.TaxRate ?? 0;
        if (string.IsNullOrWhiteSpace(_lines[idx].Description)) _lines[idx].Description = product.Description;
        RecalcLiveTotals(); MarkDirty();
    }

    private void OnDescriptionChanged(int idx, string? value)
    {
        if (_isLocked) return;
        var text = value?.Trim() ?? "";
        _lines[idx].Description = text;
        if (string.IsNullOrWhiteSpace(_lines[idx].ProductName) || _lines[idx].ProductId is null)
            _lines[idx].ProductName = text;
        MarkDirty();
    }

    private void OnLineDecimal(int idx, string field, string? raw)
    {
        if (_isLocked) return;
        if (!decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var val) &&
            !decimal.TryParse(raw, NumberStyles.Any, CultureInfo.CurrentCulture, out val))
            val = 0;
        switch (field)
        {
            case nameof(SalesOrderLine.Quantity): _lines[idx].Quantity = val; break;
            case nameof(SalesOrderLine.UnitPrice): _lines[idx].UnitPrice = val; break;
            case nameof(SalesOrderLine.Discount): _lines[idx].Discount = val; break;
            case nameof(SalesOrderLine.TaxRate): _lines[idx].TaxRate = val; break;
        }
        RecalcLiveTotals(); MarkDirty();
    }

    private void OnDocumentDiscountChanged() { RecalcLiveTotals(); MarkDirty(); }

    private void RecalcLiveTotals()
    {
        foreach (var l in _lines) ApplyLine(l);
        _liveSubtotal = Math.Round(_lines.Sum(l => LineNet(l)), 2, MidpointRounding.AwayFromZero);
        var disc = Math.Min(Math.Max(0, _model.Discount), _liveSubtotal);
        _model.Discount = disc;
        _liveTax = Math.Round(_lines.Sum(l => l.TaxAmount), 2, MidpointRounding.AwayFromZero);
        _liveGrand = Math.Round(_liveSubtotal - disc + _liveTax, 2, MidpointRounding.AwayFromZero);
        _totalsVersion++;
    }

    private static void ApplyLine(SalesOrderLine l)
    {
        l.Discount = Math.Clamp(l.Discount, 0, 100);
        l.TaxRate = Math.Max(0, l.TaxRate);
        var net = LineNet(l);
        l.TaxAmount = Math.Round(net * l.TaxRate / 100m, 2, MidpointRounding.AwayFromZero);
        l.LineTotal = Math.Round(net + l.TaxAmount, 2, MidpointRounding.AwayFromZero);
    }

    private static decimal LineNet(SalesOrderLine l) =>
        Math.Max(0, l.Quantity * l.UnitPrice * (1m - Math.Clamp(l.Discount, 0, 100) / 100m));

    private static decimal ComputeLineTotal(SalesOrderLine l) { ApplyLine(l); return l.LineTotal; }
    private static string LineDescription(SalesOrderLine l) =>
        !string.IsNullOrWhiteSpace(l.Description) ? l.Description! : (l.ProductName ?? "");
    private static string Fmt(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    private void BindDatesToModel()
    {
        _model.OrderDate = _orderDate ?? DateTime.UtcNow.Date;
        _model.RequestedDeliveryDate = _deliveryDate;
        _model.CustomerId = int.TryParse(_customerIdStr, out var cid) && cid > 0 ? cid : null;
        for (var i = 0; i < _lines.Count; i++) { _lines[i].SortOrder = i; ApplyLine(_lines[i]); }
        _model.Lines = _lines.ToList();
        RecalcLiveTotals();
        _model.Subtotal = _liveSubtotal;
        _model.TaxTotal = _liveTax;
        _model.GrandTotal = _liveGrand;
    }

    private async Task SaveDraftAsync()
    {
        _saving = true; _error = null; _ok = null;
        try
        {
            BindDatesToModel();
            if (_isNew)
            {
                var created = await Orders.CreateOrderAsync(_model);
                Nav.NavigateTo($"/orders/{created.Id}");
                return;
            }
            var updated = await Orders.UpdateOrderAsync(Id, _model)
                ?? throw new InvalidOperationException("Order not found.");
            ApplyLoaded(updated);
            _ok = "Saved.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ConfirmAsync()
    {
        await RunAction(async () =>
        {
            if (_dirty) { BindDatesToModel(); await Orders.UpdateOrderAsync(Id, _model); }
            var row = await Orders.ConfirmAsync(Id) ?? throw new InvalidOperationException("Not found.");
            ApplyLoaded(row); _ok = "Order confirmed.";
        });
    }

    private async Task FulfillAsync()
    {
        await RunAction(async () =>
        {
            var row = await Orders.FulfillAsync(Id) ?? throw new InvalidOperationException("Not found.");
            ApplyLoaded(row); _ok = "Order marked fulfilled.";
        });
    }

    private async Task CancelAsync()
    {
        await RunAction(async () =>
        {
            var row = await Orders.CancelAsync(Id) ?? throw new InvalidOperationException("Not found.");
            ApplyLoaded(row); _ok = "Order cancelled.";
        });
    }

    private async Task DeleteAsync()
    {
        await RunAction(async () =>
        {
            await Orders.DeleteOrderAsync(Id);
            Nav.NavigateTo("/orders/list");
        });
    }

    private async Task CreateInvoiceAsync()
    {
        await RunAction(async () =>
        {
            if (_dirty) { BindDatesToModel(); await Orders.UpdateOrderAsync(Id, _model); }
            var (ok, err, invoice) = await Orders.CreateInvoiceFromOrderAsync(Id);
            if (!ok || invoice is null) throw new InvalidOperationException(err ?? "Could not create invoice.");
            var refreshed = await Orders.GetOrderAsync(Id);
            if (refreshed is not null) ApplyLoaded(refreshed);
            _ok = $"Invoice {invoice.InvoiceNumber} created.";
            Nav.NavigateTo($"/finance/invoices/{invoice.Id}");
        });
    }

    private async Task RunAction(Func<Task> action)
    {
        _saving = true; _error = null; _ok = null;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private static string StatusPillClass(SalesOrder o) => o.OrderStatus switch
    {
        SalesOrderStatus.Invoiced or SalesOrderStatus.Confirmed or SalesOrderStatus.Fulfilled => "ok",
        SalesOrderStatus.Cancelled => "off",
        _ => ""
    };
}
