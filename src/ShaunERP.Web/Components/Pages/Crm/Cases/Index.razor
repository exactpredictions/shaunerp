@page "/crm/cases"
@attribute [Authorize]
@inject ICrmService Crm

<PageTitle>Cases — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div><p class="eyebrow">CRM · Service</p><h1>Cases</h1></div>
        <a class="btn" href="/crm/cases/new">Add case</a>
    </header>
    @if (_loading) { <p class="muted">Loading…</p> }
    else if (_items.Count == 0) { <p class="muted">No cases yet.</p> }
    else
    {
        <div class="table-wrap"><table>
            <thead><tr><th>Number</th><th>Subject</th><th>Priority</th><th>Status</th><th>Account</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in _items)
            {
                <tr>
                    <td>@x.CaseNumber</td>
                    <td>@x.Subject</td>
                    <td>@(x.Priority ?? "—")</td>
                    <td><span class="pill ok">@(x.CaseStatus ?? "New")</span></td>
                    <td>@(x.AccountName ?? "—")</td>
                    <td><a href="@($"/crm/cases/{x.Id}")">Edit</a></td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>

@code {
    private bool _loading = true;
    private List<CrmCase> _items = new();
    protected override async Task OnInitializedAsync()
    {
        _items = (await Crm.ListCasesAsync()).ToList();
        _loading = false;
    }
}
