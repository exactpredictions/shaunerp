@page "/crm/contacts/new"
@page "/crm/contacts/{Id:int}"
@attribute [Authorize]
@inject ICrmService Crm
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Add contact" : "Edit contact") — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">CRM · Contacts</p>
            <h1>@(_isNew ? "Add contact" : "Edit contact")</h1>
        </div>
        <a class="btn ghost" href="/crm/contacts">Back</a>
    </header>

    @if (_loading) { <p class="muted">Loading…</p> }
    else if (!_isNew && _missing) { <p class="alert">Contact not found.</p> }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card form-wide">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert">@_error</div> }
            @if (!string.IsNullOrEmpty(_ok)) { <div class="ok-msg">@_ok</div> }

            <h2 class="form-section">Basic information</h2>
            <div class="form-grid">
                <label>Contact owner <InputText @bind-Value="_model.ContactOwner" /></label>
                <label>Title <InputText @bind-Value="_model.Title" /></label>
                <label>First name <InputText @bind-Value="_model.FirstName" required /></label>
                <label>Last name <InputText @bind-Value="_model.LastName" required /></label>
                <label>Department <InputText @bind-Value="_model.Department" /></label>
                <label>Date of birth <InputDate @bind-Value="_model.DateOfBirth" /></label>
                <label>Account name <InputText @bind-Value="_model.AccountName" /></label>
                <label>Vendor name <InputText @bind-Value="_model.VendorName" /></label>
                <label>Reporting to <InputText @bind-Value="_model.ReportingTo" /></label>
                <label>Lead source <InputText @bind-Value="_model.LeadSource" /></label>
                <label>Prospect ID <InputNumber @bind-Value="_model.ProspectId" /></label>
                <label>Customer ID <InputNumber @bind-Value="_model.CustomerId" /></label>
            </div>

            <h2 class="form-section">Contact details</h2>
            <div class="form-grid">
                <label>Email <InputText @bind-Value="_model.Email" /></label>
                <label>Secondary email <InputText @bind-Value="_model.SecondaryEmail" /></label>
                <label>Phone <InputText @bind-Value="_model.Phone" /></label>
                <label>Mobile <InputText @bind-Value="_model.Mobile" /></label>
                <label>Home phone <InputText @bind-Value="_model.HomePhone" /></label>
                <label>Fax <InputText @bind-Value="_model.Fax" /></label>
                <label>Assistant <InputText @bind-Value="_model.Assistant" /></label>
                <label>Asst. phone <InputText @bind-Value="_model.AsstPhone" /></label>
                <label>Skype ID <InputText @bind-Value="_model.SkypeId" /></label>
                <label>Twitter <InputText @bind-Value="_model.Twitter" /></label>
                <label class="check"><InputCheckbox @bind-Value="_model.EmailOptOut" /> Email opt-out</label>
            </div>

            <h2 class="form-section">Mailing address</h2>
            <div class="form-grid">
                <label>Street <InputText @bind-Value="_model.MailingStreet" /></label>
                <label>City <InputText @bind-Value="_model.MailingCity" /></label>
                <label>State <InputText @bind-Value="_model.MailingState" /></label>
                <label>Zip <InputText @bind-Value="_model.MailingZip" /></label>
                <label>Country <InputText @bind-Value="_model.MailingCountry" /></label>
            </div>

            <h2 class="form-section">Other address</h2>
            <div class="form-grid">
                <label>Street <InputText @bind-Value="_model.OtherStreet" /></label>
                <label>City <InputText @bind-Value="_model.OtherCity" /></label>
                <label>State <InputText @bind-Value="_model.OtherState" /></label>
                <label>Zip <InputText @bind-Value="_model.OtherZip" /></label>
                <label>Country <InputText @bind-Value="_model.OtherCountry" /></label>
                <label>Preferred contact <InputText @bind-Value="_model.PreferredContactMethod" /></label>
                <label>Gender <InputText @bind-Value="_model.Gender" /></label>
                <label>Language <InputText @bind-Value="_model.Language" /></label>
            </div>

            <label>Description <InputTextArea @bind-Value="_model.Description" rows="3" /></label>

            <div class="form-actions">
                <button class="btn" type="submit">@(_isNew ? "Create contact" : "Save changes")</button>
                @if (!_isNew)
                {
                    <button class="btn ghost danger" type="button" @onclick="DeleteAsync">Delete</button>
                }
            </div>
        </EditForm>
    }
</section>

@code {
    [Parameter] public int Id { get; set; }
    private bool _isNew, _loading = true, _missing;
    private Contact _model = new();
    private string? _error, _ok;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; _ok = null; _missing = false;
        _isNew = Nav.ToBaseRelativePath(Nav.Uri).Contains("contacts/new", StringComparison.OrdinalIgnoreCase);
        if (_isNew) { _model = new Contact { ContactOwner = "admin" }; _loading = false; return; }
        var row = await Crm.GetContactAsync(Id);
        if (row is null) { _missing = true; _loading = false; return; }
        _model = row; _loading = false;
    }

    private async Task SaveAsync()
    {
        _error = null; _ok = null;
        if (_isNew) { var created = await Crm.CreateContactAsync(_model); Nav.NavigateTo($"/crm/contacts/{created.Id}"); return; }
        var updated = await Crm.UpdateContactAsync(Id, _model);
        if (updated is null) { _error = "Not found."; return; }
        _model = updated; _ok = "Saved.";
    }

    private async Task DeleteAsync()
    {
        if (await Crm.DeleteContactAsync(Id)) Nav.NavigateTo("/crm/contacts");
        else _error = "Delete failed.";
    }
}
