@page "/crm/contacts"
@attribute [Authorize]
@inject ICrmService Crm

<PageTitle>Contacts — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">CRM</p>
            <h1>Contacts</h1>
        </div>
        <a class="btn" href="/crm/contacts/new">Add contact</a>
    </header>

    <ImportExportPanel EntityKey="contacts" />

    @if (_loading) { <p class="muted">Loading…</p> }
    else if (_items.Count == 0) { <p class="muted">No contacts yet.</p> }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Account</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Title</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in _items)
                    {
                        <tr>
                            <td>@x.FirstName @x.LastName</td>
                            <td>@(x.AccountName ?? "—")</td>
                            <td>@(x.Email ?? "—")</td>
                            <td>@(x.Mobile ?? x.Phone ?? "—")</td>
                            <td>@(x.Title ?? "—")</td>
                            <td><a href="@($"/crm/contacts/{x.Id}")">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private List<Contact> _items = new();
    protected override async Task OnInitializedAsync()
    {
        _items = (await Crm.ListContactsAsync()).ToList();
        _loading = false;
    }
}
