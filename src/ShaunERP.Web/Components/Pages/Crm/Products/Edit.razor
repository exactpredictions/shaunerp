@page "/crm/products/new"
@page "/crm/products/{Id:int}"
@attribute [Authorize]
@inject ICrmService Crm
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Add product" : "Edit product") — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div><p class="eyebrow">CRM · Products</p><h1>@(_isNew ? "Add product" : "Edit product")</h1></div>
        <a class="btn ghost" href="/crm/products">Back</a>
    </header>
    @if (_loading) { <p class="muted">Loading…</p> }
    else if (!_isNew && _missing) { <p class="alert">Not found.</p> }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card form-wide">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert">@_error</div> }
            @if (!string.IsNullOrEmpty(_ok)) { <div class="ok-msg">@_ok</div> }
            <div class="form-grid">
                <label>Product code <InputText @bind-Value="_model.ProductCode" required /></label>
                <label>Name <InputText @bind-Value="_model.Name" required /></label>
                <label>Family <InputText @bind-Value="_model.ProductFamily" /></label>
                <label>Category <InputText @bind-Value="_model.Category" /></label>
                <label>Unit price <InputNumber @bind-Value="_model.UnitPrice" /></label>
                <label>Currency <InputText @bind-Value="_model.CurrencyCode" /></label>
                <label>UoM <InputText @bind-Value="_model.UnitOfMeasure" /></label>
                <label>Tax rate % <InputNumber @bind-Value="_model.TaxRate" /></label>
                <label class="check"><InputCheckbox @bind-Value="_model.IsActive" /> Active</label>
            </div>
            <label>Description <InputTextArea @bind-Value="_model.Description" rows="3" /></label>
            <div class="form-actions">
                <button class="btn" type="submit">@(_isNew ? "Create" : "Save")</button>
                @if (!_isNew) { <button class="btn ghost danger" type="button" @onclick="DeleteAsync">Delete</button> }
            </div>
        </EditForm>
    }
</section>

@code {
    [Parameter] public int Id { get; set; }
    private bool _isNew, _loading = true, _missing;
    private CrmProduct _model = new() { IsActive = true, CurrencyCode = "INR", UnitOfMeasure = "Each" };
    private string? _error, _ok;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; _ok = null; _missing = false;
        _isNew = Nav.ToBaseRelativePath(Nav.Uri).Contains("products/new", StringComparison.OrdinalIgnoreCase);
        if (_isNew) { _model = new CrmProduct { IsActive = true, CurrencyCode = "INR", UnitOfMeasure = "Each" }; _loading = false; return; }
        var row = await Crm.GetProductAsync(Id);
        if (row is null) { _missing = true; _loading = false; return; }
        _model = row; _loading = false;
    }

    private async Task SaveAsync()
    {
        _error = null; _ok = null;
        if (_isNew) { var c = await Crm.CreateProductAsync(_model); Nav.NavigateTo($"/crm/products/{c.Id}"); return; }
        var u = await Crm.UpdateProductAsync(Id, _model);
        if (u is null) { _error = "Not found."; return; }
        _model = u; _ok = "Saved.";
    }

    private async Task DeleteAsync()
    {
        if (await Crm.DeleteProductAsync(Id)) Nav.NavigateTo("/crm/products");
        else _error = "Delete failed.";
    }
}
