@page "/crm/accounts"
@attribute [Authorize]
@inject ICrmService Crm

<PageTitle>Accounts — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">CRM</p>
            <h1>Accounts</h1>
        </div>
        <a class="btn" href="/crm/accounts/new">Add account</a>
    </header>

    @if (_loading) { <p class="muted">Loading…</p> }
    else if (_items.Count == 0) { <p class="muted">No accounts yet.</p> }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Account</th><th>Type</th><th>Industry</th><th>Phone</th><th>Owner</th><th>Territory</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in _items)
                    {
                        <tr>
                            <td>@x.AccountName</td>
                            <td><span class="pill ok">@(x.AccountType ?? "—")</span></td>
                            <td>@(x.Industry ?? "—")</td>
                            <td>@(x.Phone ?? "—")</td>
                            <td>@(x.AccountOwner ?? "—")</td>
                            <td>@(x.Territory ?? "—")</td>
                            <td><a href="@($"/crm/accounts/{x.Id}")">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private List<Account> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _items = (await Crm.ListAccountsAsync()).ToList();
        _loading = false;
    }
}
