@page "/crm/leads"
@attribute [Authorize]
@inject ICrmService Crm

<PageTitle>Leads — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">CRM</p>
            <h1>Leads</h1>
        </div>
        <a class="btn" href="/crm/leads/new">Add lead</a>
    </header>

    <ImportExportPanel EntityKey="leads" />

    <PagedListToolbar Query="_query" TotalCount="_total" Disabled="_loading"
                      SearchPlaceholder="Search name, email, phone, company, status…"
                      QueryChanged="OnQueryChangedAsync" />

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">No leads match the current search.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Source</th>
                        <th>Owner</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in _items)
                    {
                        <tr>
                            <td>@x.FirstName @x.LastName</td>
                            <td>@(x.CompanyName ?? "—")</td>
                            <td>@(x.Email ?? "—")</td>
                            <td>@(x.Phone ?? x.Mobile ?? "—")</td>
                            <td><span class="pill ok">@(x.LeadStatus ?? "New")</span></td>
                            <td>@(x.LeadSource ?? "—")</td>
                            <td>@(x.LeadOwner ?? "—")</td>
                            <td><a href="@($"/crm/leads/{x.Id}")">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private ListQuery _query = new();
    private int _total;
    private List<Lead> _items = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnQueryChangedAsync(ListQuery query)
    {
        _query = query;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var page = await Crm.QueryLeadsAsync(_query);
            _items = page.Items.ToList();
            _total = page.TotalCount;
            _query = new ListQuery { Search = _query.Search, Page = page.Page, PageSize = page.PageSize };
        }
        finally
        {
            _loading = false;
        }
    }
}
