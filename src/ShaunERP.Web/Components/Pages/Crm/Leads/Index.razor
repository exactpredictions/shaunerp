@page "/crm/leads"
@attribute [Authorize]
@inject ICrmService Crm

<PageTitle>Leads — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">CRM</p>
            <h1>Leads</h1>
        </div>
        <a class="btn" href="/crm/leads/new">Add lead</a>
    </header>

    <ImportExportPanel EntityKey="leads" />

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">No leads yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Source</th>
                        <th>Owner</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in _items)
                    {
                        <tr>
                            <td>@x.FirstName @x.LastName</td>
                            <td>@(x.CompanyName ?? "—")</td>
                            <td>@(x.Email ?? "—")</td>
                            <td><span class="pill ok">@(x.LeadStatus ?? "New")</span></td>
                            <td>@(x.LeadSource ?? "—")</td>
                            <td>@(x.LeadOwner ?? "—")</td>
                            <td><a href="@($"/crm/leads/{x.Id}")">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private List<Lead> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _items = (await Crm.ListLeadsAsync()).ToList();
        _loading = false;
    }
}
