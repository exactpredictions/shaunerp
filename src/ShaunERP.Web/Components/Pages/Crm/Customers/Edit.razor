@page "/crm/customers/new"
@page "/crm/customers/{Id:int}"
@attribute [Authorize]
@inject ICrmService Crm
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Add customer" : "Edit customer") — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">CRM · Customers</p>
            <h1>@(_isNew ? "Add customer" : "Edit customer")</h1>
        </div>
        <a class="btn ghost" href="/crm/customers">Back</a>
    </header>

    @if (_loading) { <p class="muted">Loading…</p> }
    else if (!_isNew && _missing) { <p class="alert">Customer not found.</p> }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card form-wide">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert">@_error</div> }
            @if (!string.IsNullOrEmpty(_ok)) { <div class="ok-msg">@_ok</div> }

            <div class="form-grid">
                <label>Company name <InputText @bind-Value="_model.CompanyName" required /></label>
                <label>Primary contact <InputText @bind-Value="_model.PrimaryContact" /></label>
                <label>Owner <InputText @bind-Value="_model.CustomerOwner" /></label>
                <label>Account number <InputText @bind-Value="_model.AccountNumber" /></label>
                <label>Email <InputText @bind-Value="_model.Email" /></label>
                <label>Phone <InputText @bind-Value="_model.PhoneNumber" /></label>
                <label>Industry <InputText @bind-Value="_model.Industry" /></label>
                <label>Website <InputText @bind-Value="_model.Website" /></label>
                <label>Type
                    <InputSelect @bind-Value="_model.CustomerType">
                        <option>Business</option><option>Individual</option><option>Government</option>
                    </InputSelect>
                </label>
                <label>Rating
                    <InputSelect @bind-Value="_model.Rating">
                        <option value="">—</option><option>Hot</option><option>Warm</option><option>Cold</option>
                    </InputSelect>
                </label>
                <label>Territory <InputText @bind-Value="_model.Territory" /></label>
                <label>Payment terms <InputText @bind-Value="_model.PaymentTerms" /></label>
                <label>Credit limit <InputNumber @bind-Value="_model.CreditLimit" /></label>
                <label>Tax ID <InputText @bind-Value="_model.TaxId" /></label>
                <label>Tags <InputText @bind-Value="_model.Tags" /></label>
            </div>
            <label>Billing address <InputTextArea @bind-Value="_model.BillingAddress" rows="2" /></label>
            <label>Shipping address <InputTextArea @bind-Value="_model.ShippingAddress" rows="2" /></label>
            <label>Description <InputTextArea @bind-Value="_model.Description" rows="2" /></label>

            <div class="form-actions">
                <button class="btn" type="submit">@(_isNew ? "Create customer" : "Save changes")</button>
                @if (!_isNew)
                {
                    <button class="btn ghost danger" type="button" @onclick="DeleteAsync">Delete</button>
                }
            </div>
        </EditForm>
    }
</section>

@code {
    [Parameter] public int Id { get; set; }
    private bool _isNew, _loading = true, _missing;
    private Customer _model = new();
    private string? _error, _ok;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; _ok = null; _missing = false;
        _isNew = Nav.ToBaseRelativePath(Nav.Uri).Contains("customers/new", StringComparison.OrdinalIgnoreCase);
        if (_isNew) { _model = new Customer { PaymentTerms = "Net 30" }; _loading = false; return; }
        var row = await Crm.GetCustomerAsync(Id);
        if (row is null) { _missing = true; _loading = false; return; }
        _model = row; _loading = false;
    }

    private async Task SaveAsync()
    {
        _error = null; _ok = null;
        if (_isNew) { var created = await Crm.CreateCustomerAsync(_model); Nav.NavigateTo($"/crm/customers/{created.Id}"); return; }
        var updated = await Crm.UpdateCustomerAsync(Id, _model);
        if (updated is null) { _error = "Not found."; return; }
        _model = updated; _ok = "Saved.";
    }

    private async Task DeleteAsync()
    {
        if (await Crm.DeleteCustomerAsync(Id)) Nav.NavigateTo("/crm/customers");
        else _error = "Delete failed.";
    }
}
