@page "/crm/campaigns/new"
@page "/crm/campaigns/{Id:int}"
@attribute [Authorize]
@inject ICrmService Crm
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Add campaign" : "Edit campaign") — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div><p class="eyebrow">CRM · Campaigns</p><h1>@(_isNew ? "Add campaign" : "Edit campaign")</h1></div>
        <a class="btn ghost" href="/crm/campaigns">Back</a>
    </header>
    @if (_loading) { <p class="muted">Loading…</p> }
    else if (!_isNew && _missing) { <p class="alert">Not found.</p> }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card form-wide">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert">@_error</div> }
            @if (!string.IsNullOrEmpty(_ok)) { <div class="ok-msg">@_ok</div> }
            <div class="form-grid">
                <label>Name <InputText @bind-Value="_model.Name" required /></label>
                <label>Owner <InputText @bind-Value="_model.CampaignOwner" /></label>
                <label>Type
                    <InputSelect @bind-Value="_model.CampaignType">
                        <option>Email</option><option>Webinar</option><option>Advertisement</option>
                        <option>Event</option><option>Telemarketing</option><option>Other</option>
                    </InputSelect>
                </label>
                <label>Status
                    <InputSelect @bind-Value="_model.CampaignStatus">
                        <option>Planning</option><option>Active</option><option>Inactive</option>
                        <option>Completed</option><option>Aborted</option>
                    </InputSelect>
                </label>
                <label>Start <InputDate @bind-Value="_model.StartDate" /></label>
                <label>End <InputDate @bind-Value="_model.EndDate" /></label>
                <label>Budgeted cost <InputNumber @bind-Value="_model.BudgetedCost" /></label>
                <label>Actual cost <InputNumber @bind-Value="_model.ActualCost" /></label>
                <label>Expected revenue <InputNumber @bind-Value="_model.ExpectedRevenue" /></label>
                <label>Expected response % <InputNumber @bind-Value="_model.ExpectedResponse" /></label>
                <label>Num sent <InputNumber @bind-Value="_model.NumSent" /></label>
            </div>
            <label>Description <InputTextArea @bind-Value="_model.Description" rows="3" /></label>
            <div class="form-actions">
                <button class="btn" type="submit">@(_isNew ? "Create" : "Save")</button>
                @if (!_isNew) { <button class="btn ghost danger" type="button" @onclick="DeleteAsync">Delete</button> }
            </div>
        </EditForm>
    }
</section>

@code {
    [Parameter] public int Id { get; set; }
    private bool _isNew, _loading = true, _missing;
    private Campaign _model = new() { CampaignType = "Email", CampaignStatus = "Planning" };
    private string? _error, _ok;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; _ok = null; _missing = false;
        _isNew = Nav.ToBaseRelativePath(Nav.Uri).Contains("campaigns/new", StringComparison.OrdinalIgnoreCase);
        if (_isNew) { _model = new Campaign { CampaignOwner = "admin", CampaignType = "Email", CampaignStatus = "Planning", StartDate = DateTime.UtcNow }; _loading = false; return; }
        var row = await Crm.GetCampaignAsync(Id);
        if (row is null) { _missing = true; _loading = false; return; }
        _model = row; _loading = false;
    }

    private async Task SaveAsync()
    {
        _error = null; _ok = null;
        if (_isNew) { var c = await Crm.CreateCampaignAsync(_model); Nav.NavigateTo($"/crm/campaigns/{c.Id}"); return; }
        var u = await Crm.UpdateCampaignAsync(Id, _model);
        if (u is null) { _error = "Not found."; return; }
        _model = u; _ok = "Saved.";
    }

    private async Task DeleteAsync()
    {
        if (await Crm.DeleteCampaignAsync(Id)) Nav.NavigateTo("/crm/campaigns");
        else _error = "Delete failed.";
    }
}
