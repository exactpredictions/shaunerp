@page "/crm/meetings/new"
@page "/crm/meetings/{Id:int}"
@attribute [Authorize]
@inject ICrmService Crm
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Add meeting" : "Edit meeting") — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">CRM · Meetings</p>
            <h1>@(_isNew ? "Add meeting" : "Edit meeting")</h1>
        </div>
        <a class="btn ghost" href="/crm/meetings">Back</a>
    </header>

    @if (_loading) { <p class="muted">Loading…</p> }
    else if (!_isNew && _missing) { <p class="alert">Meeting not found.</p> }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card form-wide">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert">@_error</div> }
            @if (!string.IsNullOrEmpty(_ok)) { <div class="ok-msg">@_ok</div> }

            <div class="form-grid">
                <label>Title <InputText @bind-Value="_model.Title" required /></label>
                <label>Location <InputText @bind-Value="_model.Location" /></label>
                <label>Host <InputText @bind-Value="_model.Host" /></label>
                <label>Meeting type <InputText @bind-Value="_model.MeetingType" /></label>
                <label>From <InputDate @bind-Value="_model.From" /></label>
                <label>To <InputDate @bind-Value="_model.To" /></label>
                <label>Related to <InputText @bind-Value="_model.RelatedTo" /></label>
                <label>Repeat <InputText @bind-Value="_model.Repeat" /></label>
                <label>Participants (comma-separated) <InputText @bind-Value="_model.Participants" /></label>
                <label class="check"><InputCheckbox @bind-Value="_model.AllDay" /> All day</label>
            </div>
            <label>Agenda <InputTextArea @bind-Value="_model.Agenda" rows="3" /></label>

            <div class="form-actions">
                <button class="btn" type="submit">@(_isNew ? "Create meeting" : "Save changes")</button>
                @if (!_isNew)
                {
                    <button class="btn ghost danger" type="button" @onclick="DeleteAsync">Delete</button>
                }
            </div>
        </EditForm>
    }
</section>

@code {
    [Parameter] public int Id { get; set; }
    private bool _isNew, _loading = true, _missing;
    private Meeting _model = new();
    private string? _error, _ok;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; _ok = null; _missing = false;
        _isNew = Nav.ToBaseRelativePath(Nav.Uri).Contains("meetings/new", StringComparison.OrdinalIgnoreCase);
        if (_isNew)
        {
            var start = DateTime.UtcNow.Date.AddDays(1).AddHours(10);
            _model = new Meeting { Host = "admin", From = start, To = start.AddHours(1), MeetingType = "Online" };
            _loading = false; return;
        }
        var row = await Crm.GetMeetingAsync(Id);
        if (row is null) { _missing = true; _loading = false; return; }
        _model = row; _loading = false;
    }

    private async Task SaveAsync()
    {
        _error = null; _ok = null;
        if (_isNew) { var created = await Crm.CreateMeetingAsync(_model); Nav.NavigateTo($"/crm/meetings/{created.Id}"); return; }
        var updated = await Crm.UpdateMeetingAsync(Id, _model);
        if (updated is null) { _error = "Not found."; return; }
        _model = updated; _ok = "Saved.";
    }

    private async Task DeleteAsync()
    {
        if (await Crm.DeleteMeetingAsync(Id)) Nav.NavigateTo("/crm/meetings");
        else _error = "Delete failed.";
    }
}
