@page "/account/change-password"
@layout LoginLayout
@attribute [Authorize]

<div class="login-card">
    <p class="eyebrow">Security</p>
    <h1>Change password</h1>
    <p class="muted">You must set a new password before continuing.</p>

    @if (HasError)
    {
        <div class="alert">@(ErrorMessage ?? "Unable to change password.")</div>
    }
    @if (HasSuccess)
    {
        <div class="success-state">Password updated. Continue to the dashboard.</div>
    }

    <form method="post" action="/account/change-password/submit">
        <label>
            Current password
            <input name="currentPassword" type="password" autocomplete="current-password" required />
        </label>
        <label>
            New password
            <input name="newPassword" type="password" autocomplete="new-password" required minlength="8" />
        </label>
        <label>
            Confirm new password
            <input name="confirmPassword" type="password" autocomplete="new-password" required minlength="8" />
        </label>
        <button type="submit">Update password</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    public string? Ok { get; set; }

    private bool HasError => !string.IsNullOrWhiteSpace(Error);
    private bool HasSuccess => Ok == "1";

    private string? ErrorMessage => Error switch
    {
        "1" => "Current password is incorrect.",
        "2" => "New password must be at least 8 characters.",
        "3" => "New password and confirmation do not match.",
        "4" => "Not authenticated.",
        _ => null
    };
}
