@page "/finance/payments"
@attribute [Authorize]
@using ShaunERP.Core.Finance
@inject IFinanceService Finance

<PageTitle>Payments — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div><p class="eyebrow">Finance</p><h1>Payments</h1></div>
        <a class="btn ghost" href="/finance/invoices">Invoices</a>
    </header>

    <ImportExportPanel EntityKey="payments" />

    @if (_loading) { <p class="muted">Loading…</p> }
    else if (_error is not null) { <div class="error-state">@_error</div> }
    else if (_items.Count == 0) { <p class="muted">No payments recorded yet. Open an invoice to record a payment.</p> }
    else
    {
        <div class="table-wrap"><table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Invoice</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Reference</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in _items)
            {
                <tr>
                    <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                    <td>@(p.Invoice?.InvoiceNumber ?? $"#{p.InvoiceId}")</td>
                    <td>@p.Amount.ToString("N2")</td>
                    <td>@(p.Method ?? "—")</td>
                    <td>@(p.Reference ?? "—")</td>
                    <td>
                        @if (p.InvoiceId > 0)
                        {
                            <a href="@($"/finance/invoices/{p.InvoiceId}")">Open invoice</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>

@code {
    private bool _loading = true;
    private string? _error;
    private List<InvoicePayment> _items = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await Finance.ListPaymentsAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
