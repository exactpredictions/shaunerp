@page "/finance/payments"
@attribute [Authorize]
@inject IFinanceService Finance

<PageTitle>Payments — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">Finance</p>
            <h1>Payments</h1>
        </div>
        
    </header>

    <ImportExportPanel EntityKey="payments" />

    <PagedListToolbar Query="_query" TotalCount="_total" Disabled="_loading"
                      SearchPlaceholder="Search reference, method, invoice…"
                      QueryChanged="OnQueryChangedAsync" />

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">No matching rows.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Invoice</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Reference</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in _items)
                    {
                        <tr>
                            <td>@x.PaymentDate.ToString("yyyy-MM-dd")</td>
                            <td>@(x.Invoice?.InvoiceNumber ?? $"#{x.InvoiceId}")</td>
                            <td>@x.Amount.ToString("N2")</td>
                            <td>@(x.Method ?? "—")</td>
                            <td>@(x.Reference ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private ListQuery _query = new();
    private int _total;
    private List<ShaunERP.Core.Finance.InvoicePayment> _items = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnQueryChangedAsync(ListQuery query)
    {
        _query = query;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var page = await Finance.QueryPaymentsAsync(_query);
            _items = page.Items.ToList();
            _total = page.TotalCount;
            _query = new ListQuery { Search = _query.Search, Page = page.Page, PageSize = page.PageSize };
        }
        finally
        {
            _loading = false;
        }
    }
}
