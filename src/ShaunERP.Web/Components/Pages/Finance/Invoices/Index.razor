@page "/finance/invoices"
@attribute [Authorize]
@inject IFinanceService Finance

<PageTitle>Invoices — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">Finance</p>
            <h1>Invoices</h1>
        </div>
        <a class="btn" href="/finance/invoices/new">New invoice</a>
    </header>

    <ImportExportPanel EntityKey="invoices" />

    <PagedListToolbar Query="_query" TotalCount="_total" Disabled="_loading"
                      SearchPlaceholder="Search invoice #, customer, PO…"
                      QueryChanged="OnQueryChangedAsync" />

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">No matching rows.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in _items)
                    {
                        <tr>
                            <td>@x.InvoiceNumber</td>
                            <td>@(x.CustomerName ?? "—")</td>
                            <td>@x.InvoiceDate.ToString("yyyy-MM-dd")</td>
                            <td>@x.InvoiceStatus</td>
                            <td>@((x.GrandTotal > 0 ? x.GrandTotal : x.Amount).ToString("N2"))</td>
                            <td><a href="@($"/finance/invoices/{x.Id}")">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private ListQuery _query = new();
    private int _total;
    private List<ShaunERP.Core.Finance.Invoice> _items = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnQueryChangedAsync(ListQuery query)
    {
        _query = query;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var page = await Finance.QueryInvoicesAsync(_query);
            _items = page.Items.ToList();
            _total = page.TotalCount;
            _query = new ListQuery { Search = _query.Search, Page = page.Page, PageSize = page.PageSize };
        }
        finally
        {
            _loading = false;
        }
    }
}
