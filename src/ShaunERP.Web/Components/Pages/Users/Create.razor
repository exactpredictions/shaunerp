@page "/users/new"
@attribute [Authorize]
@inject IUserManagementService Users
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore
@inject ShaunERP.Infrastructure.Persistence.ShaunErpDbContext Db

<PageTitle>Add user — ShaunERP</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">User Management</p>
            <h1>Add user</h1>
        </div>
        <a class="btn ghost" href="/users">Back</a>
    </header>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card">
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert">@_error</div>
        }

        <div class="form-grid">
            <label>First name <InputText @bind-Value="_model.FirstName" required /></label>
            <label>Last name <InputText @bind-Value="_model.LastName" required /></label>
            <label>Username <InputText @bind-Value="_model.Username" required /></label>
            <label>Email <InputText @bind-Value="_model.Email" required /></label>
            <label>Phone <InputText @bind-Value="_model.PhoneNumber" /></label>
            <label>Password <InputText type="password" @bind-Value="_model.Password" required /></label>
            <label>Company
                <InputSelect @bind-Value="_model.CompanyId">
                    @foreach (var c in _companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
            </label>
            <label>Role
                <InputSelect @bind-Value="_model.RoleName">
                    @foreach (var r in _roles)
                    {
                        <option value="@r.Name">@r.Name</option>
                    }
                </InputSelect>
            </label>
            <label class="check"><InputCheckbox @bind-Value="_model.IsActive" /> Active</label>
        </div>
        <button class="btn" type="submit">Create user</button>
    </EditForm>
</section>

@code {
    private readonly CreateForm _model = new() { RoleName = "User", IsActive = true };
    private List<(int Id, string Name)> _companies = new();
    private List<RoleDto> _roles = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _companies = await Db.Companies.AsNoTracking()
            .OrderBy(c => c.Name)
            .Select(c => new ValueTuple<int, string>(c.Id, c.Name))
            .ToListAsync();
        if (_companies.Count > 0)
        {
            _model.CompanyId = _companies[0].Id;
        }

        _roles = (await Users.ListRolesAsync(_model.CompanyId)).ToList();
    }

    private async Task SaveAsync()
    {
        var (ok, error, user) = await Users.CreateUserAsync(new CreateUserRequest(
            _model.Username,
            _model.Email,
            _model.Password,
            _model.FirstName,
            _model.LastName,
            _model.PhoneNumber,
            _model.CompanyId,
            _model.RoleName,
            _model.IsActive));

        if (!ok)
        {
            _error = error;
            return;
        }

        Nav.NavigateTo($"/users/{user!.Id}");
    }

    private sealed class CreateForm
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string? PhoneNumber { get; set; }
        public string Password { get; set; } = "";
        public int? CompanyId { get; set; }
        public string RoleName { get; set; } = "User";
        public bool IsActive { get; set; } = true;
    }
}
