@namespace ShaunERP.Web.Components.Shared
@using ShaunERP.Core.Platform
@implements IDisposable

<div class="grid-toolbar">
    <div class="grid-search">
        <input type="search"
               class="grid-search-input"
               placeholder="@SearchPlaceholder"
               value="@_searchDraft"
               @oninput="OnSearchInput"
               @onkeydown="OnSearchKeyDown"
               aria-label="Search list" />
        <button class="btn" type="button" @onclick="ApplySearchAsync" disabled="@Disabled">Search</button>
        @if (!string.IsNullOrWhiteSpace(Query.Search))
        {
            <button class="btn ghost" type="button" @onclick="ClearSearchAsync" disabled="@Disabled">Clear</button>
        }
    </div>
    <div class="grid-pager">
        <label class="grid-page-size">
            <span>Rows</span>
            <select value="@Query.NormalizedPageSize" @onchange="OnPageSizeChanged" disabled="@Disabled">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>
        </label>
        <span class="muted grid-page-summary">
            @if (TotalCount == 0)
            {
                <text>No matching rows</text>
            }
            else
            {
                <text>@FromRow–@ToRow of @TotalCount.ToString("N0")</text>
            }
        </span>
        <div class="grid-page-buttons">
            <button class="btn ghost" type="button" disabled="@(Disabled || !HasPrevious)" @onclick="GoFirstAsync">First</button>
            <button class="btn ghost" type="button" disabled="@(Disabled || !HasPrevious)" @onclick="GoPrevAsync">Prev</button>
            <span class="muted">Page @Page / @Math.Max(1, TotalPages)</span>
            <button class="btn ghost" type="button" disabled="@(Disabled || !HasNext)" @onclick="GoNextAsync">Next</button>
            <button class="btn ghost" type="button" disabled="@(Disabled || !HasNext)" @onclick="GoLastAsync">Last</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public ListQuery Query { get; set; } = new();
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "Search any column…";
    [Parameter] public EventCallback<ListQuery> QueryChanged { get; set; }

    private string _searchDraft = string.Empty;
    private System.Threading.Timer? _debounce;
    private int _debounceVersion;

    private int Page => Query.NormalizedPage;
    private int PageSize => Query.NormalizedPageSize;
    private int TotalPages => PageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));
    private int FromRow => TotalCount == 0 ? 0 : ((Page - 1) * PageSize) + 1;
    private int ToRow => Math.Min(Page * PageSize, TotalCount);
    private bool HasPrevious => Page > 1 && TotalCount > 0;
    private bool HasNext => Page * PageSize < TotalCount;

    protected override void OnParametersSet()
    {
        _searchDraft = Query.Search ?? string.Empty;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchDraft = e.Value?.ToString() ?? string.Empty;
        _debounce?.Dispose();
        var version = ++_debounceVersion;
        _debounce = new System.Threading.Timer(async _ =>
        {
            if (version != _debounceVersion)
            {
                return;
            }

            await InvokeAsync(async () => await EmitAsync(Query.WithSearch(_searchDraft)));
        }, null, 350, Timeout.Infinite);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
        {
            _debounce?.Dispose();
            await ApplySearchAsync();
        }
    }

    private async Task ApplySearchAsync()
    {
        _debounce?.Dispose();
        await EmitAsync(Query.WithSearch(_searchDraft));
    }

    private async Task ClearSearchAsync()
    {
        _searchDraft = string.Empty;
        _debounce?.Dispose();
        await EmitAsync(Query.WithSearch(null));
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size))
        {
            return;
        }

        await EmitAsync(Query.WithPageSize(size));
    }

    private Task GoFirstAsync() => EmitAsync(Query.WithPage(1));
    private Task GoPrevAsync() => EmitAsync(Query.WithPage(Page - 1));
    private Task GoNextAsync() => EmitAsync(Query.WithPage(Page + 1));
    private Task GoLastAsync() => EmitAsync(Query.WithPage(TotalPages));

    private async Task EmitAsync(ListQuery next)
    {
        Query = next;
        if (QueryChanged.HasDelegate)
        {
            await QueryChanged.InvokeAsync(next);
        }
    }

    public void Dispose() => _debounce?.Dispose();
}
